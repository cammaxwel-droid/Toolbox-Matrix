<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>WinGetToolbox</AssemblyName>
    <Configurations>Debug;Release;V1</Configurations>
    <Version>0.5.0</Version>
    <AssemblyVersion>0.5.0.0</AssemblyVersion>
    <FileVersion>0.5.0.0</FileVersion>
    <InformationalVersion>0.5.0-FP0.5.0</InformationalVersion>
    <Product>Toolbox Matrix</Product>
    <Description>Toolbox Matrix — A Toolbox for WinGet</Description>
    <ApplicationIcon>Assets\Toolbox Matrix.ico</ApplicationIcon>
  </PropertyGroup>

  <!-- V1 is an isolated candidate configuration. Debug/Release keep the full development UI. -->
  <PropertyGroup Condition="'$(Configuration)' == 'V1'">
    <DefineConstants>$(DefineConstants);TOOLBOX_V1</DefineConstants>
    <Optimize>true</Optimize>
    <Version>1.0.0-candidate</Version>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>1.0.0.0</FileVersion>
    <InformationalVersion>1.0.0-candidate</InformationalVersion>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Assets\Toolbox Matrix.ico" />
  </ItemGroup>
</Project>
